{
  "folders": [{ "path": "." }],
  "settings": {
    "window.title": "🐘 PostgreSQL Performance Lab",
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#176B58",
      "titleBar.activeForeground": "#FFFFFF",
      "titleBar.inactiveBackground": "#104C40",
      "titleBar.inactiveForeground": "#FFFFFF"
    },
    "files.encoding": "utf8",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "editor.wordWrap": "on",
    "editor.rulers": [100],
    "editor.renderWhitespace": "boundary",
    "markdown.preview.breaks": true,
    "markdown.validate.enabled": true,
    "markdown.validate.fileLinks.enabled": "warning",
    "markdown.validate.fragmentLinks.enabled": "warning",
    "files.exclude": { "**/.DS_Store": true, "**/Thumbs.db": true },
    "search.exclude": { "**/.git": true },
    "[sql]": {
      "editor.tabSize": 4,
      "editor.insertSpaces": true
    }
  },
  "extensions": {
    "recommendations": [
      "yzhang.markdown-all-in-one",
      "DavidAnson.vscode-markdownlint",
      "bierner.markdown-preview-github-styles",
      "eamodio.gitlens",
      "mtxr.sqltools",
      "mtxr.sqltools-driver-pg",
      "ms-azuretools.vscode-docker"
    ]
  }
}
